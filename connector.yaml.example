# Place at <PORTAL_HOME>/connectors/<domain-id>/connector.yaml.
domainId: alice
connectorId: replace-with-platform-connector-id
liteEndpoint: https://127.0.0.1:28081
certDir: ./certs

# 文件管理已内置到 Kuscia Lite KusciaAPI，无需配置独立 endpoint、serviceHost 或 token。
# 门户会复用 Lite 的 mTLS 证书和 Token，直接访问 liteEndpoint（默认 28081）。
