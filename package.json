{
  "name": "bonfire-connector-portal",
  "private": true,
  "version": "0.1.0",
  "description": "Bonfire-TDS 连接器门户（React 前端 + Python/FastAPI 后端）",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "python -m uvicorn bonfire_portal.main:app --host 0.0.0.0 --port ${PORT:-8100} --reload",
    "dev:web": "npm run dev --workspace web",
    "dev:server": "python -m uvicorn bonfire_portal.main:app --host 0.0.0.0 --port ${PORT:-8100} --reload",
    "build": "npm run build --workspace web",
    "start": "python -m uvicorn bonfire_portal.main:app --host 0.0.0.0 --port ${PORT:-8100} --workers 1"
  }
}
